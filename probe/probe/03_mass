<script>
// ===== Periodic Table: Z -> element symbol =====
const ELEMENTS = [
    null, 'H','He','Li','Be','B','C','N','O','F','Ne',
    'Na','Mg','Al','Si','P','S','Cl','Ar','K','Ca',
    'Sc','Ti','V','Cr','Mn','Fe','Co','Ni','Cu','Zn',
    'Ga','Ge','As','Se','Br','Kr','Rb','Sr','Y','Zr',
    'Nb','Mo','Tc','Ru','Rh','Pd','Ag','Cd','In','Sn',
    'Sb','Te','I','Xe','Cs','Ba','La','Ce','Pr','Nd',
    'Pm','Sm','Eu','Gd','Tb','Dy','Ho','Er','Tm','Yb',
    'Lu','Hf','Ta','W','Re','Os','Ir','Pt','Au','Hg',
    'Tl','Pb','Bi','Po','At','Rn','Fr','Ra','Ac','Th',
    'Pa','U','Np','Pu','Am','Cm','Bk','Cf','Es','Fm',
    'Md','No','Lr','Rf','Db','Sg','Bh','Hs','Mt','Ds',
    'Rg','Cn','Nh','Fl','Mc','Lv','Ts','Og',
    /* 119-132: IUPAC systematic element names */
    'Uue','Ubn','Ubu','Ubb','Ubt','Ubq','Ubp','Ubh','Ubs','Ubo','Ube',
    'Utn','Utu','Utb'
];

// Build reverse map: symbol -> Z
const SYM2Z = {};
for (let z = 1; z < ELEMENTS.length; z++) {
    if (ELEMENTS[z]) SYM2Z[ELEMENTS[z].toLowerCase()] = z;
}

// Populate element selector
(function() {
    const sel = document.getElementById('searchEl');
    for (let z = 1; z < ELEMENTS.length; z++) {
        const el = ELEMENTS[z];
        if (!el) continue;
        const opt = document.createElement('option');
        opt.value = z;
        opt.textContent = z + ' ' + el;
        sel.appendChild(opt);
    }
})();

// ===== Data store =====
let nuclearData = [];       // array of objects
let dataLoaded = false;
let loadPromise = null;

// Column names for the table display
const COL_LABELS = {
    A: 'A', Z: 'Z', N: 'N',
    BE: 'BE (MeV)', Rch: 'Rch (fm)',
    Beta2: 'β₂', Beta4: 'β₄', Beta6: 'β₆',
    Esh: 'Esh (MeV)',
    Sn: 'Sn (MeV)', S2n: 'S2n (MeV)',
    Sp: 'Sp (MeV)', S2p: 'S2p (MeV)',
    Gap_2n: 'Gap_2n (MeV)', Gap_2p: 'Gap_2p (MeV)',
    Qa: 'Qα (MeV)', logT_a: 'logT_α (s)',
    Bf: 'Bf (MeV)', logT_SF: 'logT_SF (s)'
};
const COL_KEYS = Object.keys(COL_LABELS);

// Fields that should display as-is (numerical or "---")
const NUM_FIELDS = new Set(COL_KEYS);

function parseVal(v) {
    v = v.trim();
    if (v === '---' || v === '') return null;
    const n = parseFloat(v);
    return isNaN(n) ? null : n;
}

function loadData() {
    if (loadPromise) return loadPromise;
    loadPromise = fetch('./complete_nuclear_table.txt')
        .then(r => {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
        })
        .then(text => {
            const lines = text.split('\n');
            let dataLines = [];
            let inHeader = true;
            for (let line of lines) {
                const trimmed = line.trim();
                if (trimmed.startsWith('#')) continue;
                if (trimmed.startsWith('---')) continue;
                if (inHeader && /^\s*A\s+Z\s+N/.test(line)) {
                    inHeader = false;
                    continue;
                }
                if (inHeader) continue;
                if (trimmed === '') continue;
                const parts = trimmed.split(/\s+/);
                if (parts.length < 19) continue;

                const a = parseInt(parts[0]);
                const z = parseInt(parts[1]);
                if (isNaN(a) || isNaN(z)) continue;

                const rec = {
                    A: a, Z: z, N: a - z,
                    BE: parseVal(parts[3]),
                    Rch: parseVal(parts[4]),
                    Beta2: parseVal(parts[5]),
                    Beta4: parseVal(parts[6]),
                    Beta6: parseVal(parts[7]),
                    Esh: parseVal(parts[8]),
                    Sn: parseVal(parts[9]),
                    S2n: parseVal(parts[10]),
                    Sp: parseVal(parts[11]),
                    S2p: parseVal(parts[12]),
                    Gap_2n: parseVal(parts[13]),
                    Gap_2p: parseVal(parts[14]),
                    Qa: parseVal(parts[15]),
                    logT_a: parseVal(parts[16]),
                    Bf: parseVal(parts[17]),
                    logT_SF: parseVal(parts[18])
                };
                dataLines.push(rec);
            }
            nuclearData = dataLines;
            dataLoaded = true;
            return nuclearData;
        });
    return loadPromise;
}

// ===== Search =====
function searchNucleus(A, Z) {
    if (!dataLoaded) return null;
    for (let rec of nuclearData) {
        if (rec.A === A && rec.Z === Z) return rec;
    }
    return null;
}

// ===== Display result =====
function displayResult(rec) {
    const area = document.getElementById('resultArea');
    area.style.display = 'block';

    if (!rec) {
        area.innerHTML = '<div class="result-card"><div class="no-result"><div class="big-icon">&#128204;</div><p>No data found for this nucleus in the WS4 mass table.</p></div></div>';
        return;
    }

    const sym = ELEMENTS[rec.Z] || '?';
    const isoLabel = rec.A + sym;

    // Build grid items
    let gridHTML = '';
    const gridFields = [
        ['BE (MeV)', rec.BE],
        ['β₂', rec.Beta2],
        ['β₄', rec.Beta4],
        ['β₆', rec.Beta6],
        ['R<sub>ch</sub> (fm)', rec.Rch],
        ['E<sub>sh</sub> (MeV)', rec.Esh],
        ['S<sub>n</sub> (MeV)', rec.Sn],
        ['S<sub>2n</sub> (MeV)', rec.S2n],
        ['S<sub>p</sub> (MeV)', rec.Sp],
        ['S<sub>2p</sub> (MeV)', rec.S2p],
        ['Δ<sub>2n</sub> (MeV)', rec.Gap_2n],
        ['Δ<sub>2p</sub> (MeV)', rec.Gap_2p],
        ['Q<sub>α</sub> (MeV)', rec.Qa],
        ['log T<sub>α</sub> (log₁₀ s)', rec.logT_a],
        ['B<sub>f</sub> (MeV)', rec.Bf],
        ['log T<sub>SF</sub> (log₁₀ s)', rec.logT_SF]
    ];

    for (const [label, val, isInt] of gridFields) {
        let display;
        let cls = '';
        if (val === null || val === undefined) {
            display = '---';
            cls = 'na';
        } else if (isInt) {
            display = val;
        } else {
            display = val.toFixed(4);
        }
        gridHTML += `<div class="result-item"><span class="label">${label}</span><span class="value ${cls}">${display}</span></div>`;
    }

    area.innerHTML = `
        <div class="result-card">
            <div class="card-header">
                <h2>WS4 & related predictions</h2>
                <span class="nucleus-label">${isoLabel}</span>
            </div>
            <div class="card-body">
                <div class="result-grid">${gridHTML}</div>
            </div>
        </div>`;
}

// ===== Perform search from inputs =====
function performSearch() {
    const A1 = parseInt(document.getElementById('searchA').value);
    const Z1 = parseInt(document.getElementById('searchZ').value);
    const A2 = parseInt(document.getElementById('searchA2').value);
    const elVal = document.getElementById('searchEl').value;

    let A, Z;

    if (!isNaN(A1) && !isNaN(Z1)) {
        A = A1; Z = Z1;
    } else if (!isNaN(A2) && elVal !== '') {
        A = A2; Z = parseInt(elVal);
    } else {
        // try to parse as element symbol from text input fallback
        const area = document.getElementById('resultArea');
        area.style.display = 'block';
        area.innerHTML = '<div class="result-card"><div class="no-result"><div class="big-icon">&#9888;</div><p>Please enter A and Z, or A and select an element.</p></div></div>';
        return;
    }

    if (Z < 0 || Z > 132) {
        const area = document.getElementById('resultArea');
        area.style.display = 'block';
        area.innerHTML = '<div class="result-card"><div class="no-result"><div class="big-icon">&#9888;</div><p>Invalid Z value. Z must be between 0 and 132.</p></div></div>';
        return;
    }

    // show loading
    const area = document.getElementById('resultArea');
    area.style.display = 'block';
    area.innerHTML = '<div class="result-card"><div class="status-msg"><span class="spinner"></span> Loading nuclear data...</div></div>';

    loadData().then(() => {
        const rec = searchNucleus(A, Z);
        displayResult(rec);
    }).catch(err => {
        area.innerHTML = '<div class="result-card"><div class="no-result"><div class="big-icon">&#10060;</div><p>Failed to load data: ' + err.message + '</p></div></div>';
    });
}

// ===== Event binding =====
document.getElementById('searchBtn').addEventListener('click', performSearch);

// Enter key support
['searchA','searchZ','searchA2','searchEl'].forEach(id => {
    const el = document.getElementById(id);
    el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') performSearch();
    });
});

// Preload data in background
loadData();

// If URL has ?A=208&Z=82 or similar, auto-search
(function() {
    const params = new URLSearchParams(window.location.search);
    const qA = params.get('A');
    const qZ = params.get('Z');
    if (qA && qZ) {
        document.getElementById('searchA').value = qA;
        document.getElementById('searchZ').value = qZ;
        setTimeout(performSearch, 500);
    }
})();
</script>
</body>
</html>
